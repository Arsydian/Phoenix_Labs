# Phoenix Labs Academy — Environment Configuration Template
# Copy to .env.local for local overrides (never commit credentials to git)

# Cloudflare D1 Database UUID (obtained from 'wrangler d1 create secops-db')
CLOUDFLARE_D1_DATABASE_ID=""

# Cloudflare Zero Trust Team Domain (e.g., https://yourteam.cloudflareaccess.com)
CF_ACCESS_TEAM_DOMAIN=""

# Dedicated Admin Allowlist: Comma-separated emails authorized for /api/admin/* endpoints
ADMIN_EMAILS="admin@phoenixlabs.io,security-team@phoenixlabs.io"
